{
    "version": "2026.7.9",
    "description": "Make Me Admin - Temporary Admin Permissions",
    "homepage": "https://git.cubeone.de/marvin.fenssel/make-me-admin",
    "license": "Proprietary",
    "url": "https://raw.githubusercontent.com/cube-one-gxp-lifescience-partner/cubeone-bucket/master/LICENSE",
    "hash": "6b0382b16279f26ff69014300541967a356a666eb0b91b422f6862f6b7dad17e",
    "pre_install": [
        "Remove-Item \"$dir\\LICENSE\" -ErrorAction SilentlyContinue",
        "",
        "if (-not $env:AUTO_UPDATER_API_KEY) {",
        "    throw 'AUTO_UPDATER_API_KEY environment variable not set'",
        "}",
        "",
        "Write-Host 'Downloading Make Me Admin from cube one update server...' -ForegroundColor Blue",
        "",
        "$headers = @{",
        "    'X-API-Key' = $env:AUTO_UPDATER_API_KEY",
        "    'User-Agent' = 'cube-one-auto-updater/1.0'",
        "}",
        "",
        "$downloadUrl = 'https://update.cubeone.de/files/2050e6e9-925e-48ad-92c1-0b410b812181'",
        "$downloadPath = \"$cachedir\\make_me_admin_installer.exe\"",
        "",
        "try {",
        "    Invoke-WebRequest -Uri $downloadUrl -Headers $headers -OutFile $downloadPath -TimeoutSec 120",
        "",
        "    if (-not (Test-Path $downloadPath)) {",
        "        throw 'Downloaded file not found'",
        "    }",
        "",
        "    $fileInfo = Get-Item $downloadPath",
        "    Write-Host \"Download successful: $($fileInfo.Length) bytes\" -ForegroundColor Green",
        "",
        "    $expectedHash = 'FF7728DCFF0809707B33ECA94E345B155A2287F736A4699F17EBDBB162A14756'",
        "    $actualHash = (Get-FileHash -Path $downloadPath -Algorithm SHA256).Hash",
        "    if ($actualHash -ne $expectedHash) {",
        "        throw \"SHA256 hash mismatch for make_me_admin_installer.exe. Expected: $expectedHash, Actual: $actualHash\"",
        "    }",
        "    Write-Host 'SHA256 hash verified for make_me_admin_installer.exe' -ForegroundColor Green",
        "",
        "    Copy-Item -Path $downloadPath -Destination \"$dir\\make_me_admin_installer.exe\" -Force",
        "} catch {",
        "    throw \"Failed to download Make Me Admin: $($_.Exception.Message)\"",
        "}",
        "",
        "Remove-Item $downloadPath -ErrorAction SilentlyContinue",
        "",
        "Write-Host 'Make Me Admin downloaded successfully!' -ForegroundColor Green"
    ],
    "installer": {
        "script": [
            "Write-Host 'Installing Make Me Admin...'",
            "& \"$dir\\make_me_admin_installer.exe\"",
            "Write-Host 'Installation completed'",
            "$shortcutPath = 'AppData\\Roaming\\Microsoft\\Windows\\Start Menu\\Programs\\Scoop Apps\\Make Me Admin.lnk'",
            "$targetPath = 'C:\\cubeone\\make_me_admin\\client\\make_me_admin.exe'",
            "$WScriptShell = New-Object -ComObject WScript.Shell",
            "$shortcut = $WScriptShell.CreateShortcut($shortcutPath)",
            "$shortcut.TargetPath = $targetPath",
            "$shortcut.WorkingDirectory = Split-Path $targetPath",
            "$shortcut.Description = 'Admin Elevation Client'",
            "$shortcut.Save()"
        ]
    },
    "uninstaller": {
        "script": [
            "Write-Host 'Uninstalling Make Me Admin...' -ForegroundColor Yellow",
            "Stop-Service -Name 'MakeMeAdminService'",
            "sc delete MakeMeAdminService",
            "Remove-Item -Path 'C:\\cubeone\\make_me_admin' -Force -Recurse -ErrorAction SilentlyContinue",
            "Write-Host 'Make Me Admin uninstalled!' -ForegroundColor Green"
        ]
    },
    "notes": [
        "Administrator privileges required",
        "Downloaded from update.cubeone.de",
        "Requires AUTO_UPDATER_API_KEY environment variable for authentication",
        "SHA256 hash verified for make_me_admin_installer.exe after download"
    ]
}
