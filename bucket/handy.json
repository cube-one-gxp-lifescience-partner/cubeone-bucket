{
    "version": "0.10.1",
    "description": "Offline speech-to-text with cube one settings, portable data and the Parakeet Ultra model.",
    "homepage": "https://handy.computer/",
    "license": "MIT",
    "notes": [
        "Portable mode stores settings, history and models in $persist_dir\\Data. Updates keep that directory.",
        "On first install, settings are copied from Desktop\\Handy when that folder exists. Otherwise the cube one defaults are written.",
        "Parakeet Ultra Q8 is reused from an existing Handy folder when the file is already there, otherwise it is downloaded.",
        "In-app updates are switched off in the seeded settings. Update Handy with scoop update.",
        "Autostart is pointed at the Scoop copy of handy.exe."
    ],
    "architecture": {
        "64bit": {
            "url": "https://github.com/cjpais/Handy/releases/download/v0.10.1/Handy_0.10.1_x64-setup.exe#/dl.7z",
            "hash": "3d0c05cfe2717370e64ca71e6cb36dd575d8b0f28424f48e00efe18565a04edf"
        },
        "arm64": {
            "url": "https://github.com/cjpais/Handy/releases/download/v0.10.1/Handy_0.10.1_arm64-setup.exe#/dl.7z",
            "hash": "b001d3c58d61e09529bc9e18a1df5eb64bd42681d69b034db3a354edecc33650"
        }
    },
    "pre_install": [
        "Remove-Item -LiteralPath (Join-Path $dir '$PLUGINSDIR') -Recurse -Force -ErrorAction SilentlyContinue",
        "Remove-Item -Path (Join-Path $dir 'Uninstall*.exe') -Force -ErrorAction SilentlyContinue",
        "Set-Content -LiteralPath (Join-Path $dir 'portable') -Value 'Handy Portable Mode' -Encoding ascii -NoNewline"
    ],
    "post_install": [
        "$ErrorActionPreference = 'Stop'",
        "if (-not $dir) { abort 'Scoop variable $dir is not set' }",
        "if (-not $persist_dir) { abort 'Scoop variable $persist_dir is not set' }",
        "",
        "$dataDir = Join-Path $persist_dir 'Data'",
        "$modelsDir = Join-Path $dataDir 'models'",
        "$settingsPath = Join-Path $dataDir 'settings_store.json'",
        "$modelName = 'parakeet-ultra-Q8_0.gguf'",
        "$modelPath = Join-Path $modelsDir $modelName",
        "$expectedSize = [int64]740363168",
        "$expectedHash = '007a59761e9258779f189df396b50d12b83bb5b79e66df4b955c230d2f2a0a59'",
        "$modelUrl = 'https://huggingface.co/handy-computer/parakeet-ultra-gguf/resolve/main/parakeet-ultra-Q8_0.gguf?download=true'",
        "$defaultSettings = ''",
        "New-Item -ItemType Directory -Path $modelsDir -Force | Out-Null",
        "",
        "function Test-HandyModelFile {",
        "    param([string]$Path)",
        "    if (-not (Test-Path -LiteralPath $Path -PathType Leaf)) {",
        "        return $false",
        "    }",
        "    return ((Get-Item -LiteralPath $Path).Length -eq $expectedSize)",
        "}",
        "",
        "function Get-HandyImportDirs {",
        "    $roots = New-Object System.Collections.Generic.List[string]",
        "    [void]$roots.Add($env:USERPROFILE)",
        "    $oneDrives = Get-ChildItem -Path $env:USERPROFILE -Directory -Filter 'OneDrive*' -ErrorAction SilentlyContinue",
        "    foreach ($oneDrive in $oneDrives) {",
        "        [void]$roots.Add($oneDrive.FullName)",
        "    }",
        "    $found = New-Object System.Collections.Generic.List[string]",
        "    $own = [System.IO.Path]::GetFullPath($dataDir).TrimEnd('\\')",
        "    foreach ($root in $roots) {",
        "        $candidate = Join-Path $root 'Desktop\\Handy\\Data'",
        "        if (-not (Test-Path -LiteralPath $candidate -PathType Container)) {",
        "            continue",
        "        }",
        "        $full = [System.IO.Path]::GetFullPath($candidate).TrimEnd('\\')",
        "        if ($full -eq $own) {",
        "            continue",
        "        }",
        "        [void]$found.Add($full)",
        "    }",
        "    return @($found | Select-Object -Unique)",
        "}",
        "",
        "function Find-HandyModel {",
        "    param([string]$Root)",
        "    $direct = Join-Path $Root (Join-Path 'models' $modelName)",
        "    if (Test-HandyModelFile -Path $direct) {",
        "        return $direct",
        "    }",
        "    $snapshots = Join-Path $Root 'huggingface\\hub\\models--handy-computer--parakeet-ultra-gguf\\snapshots'",
        "    if (Test-Path -LiteralPath $snapshots -PathType Container) {",
        "        $hit = Get-ChildItem -Path $snapshots -Recurse -Filter $modelName -File -ErrorAction SilentlyContinue |",
        "            Where-Object { $_.Length -eq $expectedSize } |",
        "            Select-Object -First 1",
        "        if ($hit) {",
        "            return $hit.FullName",
        "        }",
        "    }",
        "    return $null",
        "}",
        "",
        "if (-not (Test-Path -LiteralPath $settingsPath -PathType Leaf)) {",
        "    $importedSettings = $null",
        "    foreach ($importDir in @(Get-HandyImportDirs)) {",
        "        $candidate = Join-Path $importDir 'settings_store.json'",
        "        if (Test-Path -LiteralPath $candidate -PathType Leaf) {",
        "            $importedSettings = $candidate",
        "            break",
        "        }",
        "    }",
        "    $utf8 = New-Object System.Text.UTF8Encoding $false",
        "    if ($importedSettings) {",
        "        Copy-Item -LiteralPath $importedSettings -Destination $settingsPath -Force",
        "        $historySource = Join-Path (Split-Path -Parent $importedSettings) 'history.db'",
        "        $historyDest = Join-Path $dataDir 'history.db'",
        "        if ((Test-Path -LiteralPath $historySource -PathType Leaf) -and -not (Test-Path -LiteralPath $historyDest)) {",
        "            Copy-Item -LiteralPath $historySource -Destination $historyDest -Force",
        "        }",
        "        Write-Host \"Handy settings imported from $importedSettings\"",
        "    } else {",
        "        $jsonText = [System.Text.Encoding]::UTF8.GetString([Convert]::FromBase64String($defaultSettings))",
        "        [System.IO.File]::WriteAllText($settingsPath, $jsonText, $utf8)",
        "        Write-Host 'Handy default settings written.'",
        "    }",
        "    $settingsRaw = [System.IO.File]::ReadAllText($settingsPath)",
        "    $settingsRaw = $settingsRaw -replace '\"update_checks_enabled\"\\s*:\\s*true', '\"update_checks_enabled\": false'",
        "    [System.IO.File]::WriteAllText($settingsPath, $settingsRaw, $utf8)",
        "}",
        "",
        "$resolvedModel = $null",
        "if (Test-HandyModelFile -Path $modelPath) {",
        "    $resolvedModel = $modelPath",
        "} else {",
        "    $resolvedModel = Find-HandyModel -Root $dataDir",
        "    if ($resolvedModel) {",
        "        Write-Host \"Handy model already stored in $resolvedModel\"",
        "    }",
        "}",
        "",
        "if (-not $resolvedModel) {",
        "    $sourceModel = $null",
        "    foreach ($importDir in @(Get-HandyImportDirs)) {",
        "        $sourceModel = Find-HandyModel -Root $importDir",
        "        if ($sourceModel) {",
        "            break",
        "        }",
        "    }",
        "    if (-not $sourceModel) {",
        "        $userSnapshots = Join-Path $env:USERPROFILE '.cache\\huggingface\\hub\\models--handy-computer--parakeet-ultra-gguf\\snapshots'",
        "        if (Test-Path -LiteralPath $userSnapshots -PathType Container) {",
        "            $hit = Get-ChildItem -Path $userSnapshots -Recurse -Filter $modelName -File -ErrorAction SilentlyContinue |",
        "                Where-Object { $_.Length -eq $expectedSize } |",
        "                Select-Object -First 1",
        "            if ($hit) {",
        "                $sourceModel = $hit.FullName",
        "            }",
        "        }",
        "    }",
        "    if ($sourceModel) {",
        "        Write-Host \"Copying Handy model from $sourceModel\"",
        "        Copy-Item -LiteralPath $sourceModel -Destination $modelPath -Force",
        "        if (Test-HandyModelFile -Path $modelPath) {",
        "            $resolvedModel = $modelPath",
        "        }",
        "    }",
        "}",
        "",
        "if (-not $resolvedModel) {",
        "    Write-Host 'Downloading Parakeet Ultra Q8 (about 706 MB)...'",
        "    $partial = \"$modelPath.partial\"",
        "    $curlArgs = @('-L', '--fail', '--retry', '3', '--retry-delay', '2', '-o', $partial, $modelUrl)",
        "    if (Test-Path -LiteralPath $partial -PathType Leaf) {",
        "        $curlArgs = @('-C', '-') + $curlArgs",
        "    }",
        "    & curl.exe @curlArgs",
        "    if ($LASTEXITCODE -ne 0) {",
        "        abort \"Handy model download failed (curl exit $LASTEXITCODE)\"",
        "    }",
        "    Move-Item -LiteralPath $partial -Destination $modelPath -Force",
        "    if (Test-HandyModelFile -Path $modelPath) {",
        "        $resolvedModel = $modelPath",
        "    }",
        "}",
        "",
        "if (-not $resolvedModel) {",
        "    abort \"Handy model is missing or has an unexpected size: $modelPath\"",
        "}",
        "",
        "Write-Host \"Verifying Handy model SHA256...\"",
        "$actualHash = (Get-FileHash -LiteralPath $resolvedModel -Algorithm SHA256).Hash.ToLowerInvariant()",
        "if ($actualHash -ne $expectedHash) {",
        "    if ($resolvedModel -eq $modelPath) {",
        "        Remove-Item -LiteralPath $modelPath -Force -ErrorAction SilentlyContinue",
        "    }",
        "    abort \"Handy model SHA256 mismatch. Expected $expectedHash, got $actualHash\"",
        "}",
        "Write-Host 'Handy model verified.'",
        "",
        "$settingsObject = Get-Content -LiteralPath $settingsPath -Raw | ConvertFrom-Json",
        "$appDir = Split-Path -Parent $dir",
        "$handyExe = Join-Path $dir 'handy.exe'",
        "if ((Split-Path -Leaf $dir) -ne 'current') {",
        "    $currentExe = Join-Path (Join-Path $appDir 'current') 'handy.exe'",
        "    if (Test-Path -LiteralPath $currentExe -PathType Leaf) {",
        "        $handyExe = $currentExe",
        "    }",
        "}",
        "if ($settingsObject.settings.autostart_enabled) {",
        "    $runKey = 'HKCU:\\Software\\Microsoft\\Windows\\CurrentVersion\\Run'",
        "    New-Item -Path $runKey -Force | Out-Null",
        "    Set-ItemProperty -Path $runKey -Name 'Handy' -Value $handyExe",
        "    Write-Host \"Autostart set to $handyExe\"",
        "}",
        "",
        "$markerPath = Join-Path $dir 'portable'",
        "$marker = [System.IO.File]::ReadAllText($markerPath).Trim()",
        "if (-not $marker.StartsWith('Handy Portable Mode')) {",
        "    abort 'Portable marker is missing or invalid'",
        "}",
        "if (-not (Test-Path -LiteralPath (Join-Path $dir 'handy.exe') -PathType Leaf)) {",
        "    abort 'handy.exe was not found after extraction'",
        "}",
        "Write-Host \"Handy data directory: $dataDir\"",
        ""
    ],
    "pre_uninstall": [
        "$appDir = (Split-Path -Parent $dir).TrimEnd('\\') + '\\'",
        "Get-Process -Name 'handy' -ErrorAction SilentlyContinue | Where-Object { $_.Path -and $_.Path.StartsWith($appDir, [System.StringComparison]::OrdinalIgnoreCase) } | Stop-Process -Force -ErrorAction SilentlyContinue",
        "Start-Sleep -Seconds 2"
    ],
    "persist": "Data",
    "bin": "handy.exe",
    "shortcuts": [
        [
            "handy.exe",
            "Handy"
        ]
    ],
    "checkver": {
        "github": "https://github.com/cjpais/Handy"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/cjpais/Handy/releases/download/v$version/Handy_$version_x64-setup.exe#/dl.7z"
            },
            "arm64": {
                "url": "https://github.com/cjpais/Handy/releases/download/v$version/Handy_$version_arm64-setup.exe#/dl.7z"
            }
        }
    }
}
