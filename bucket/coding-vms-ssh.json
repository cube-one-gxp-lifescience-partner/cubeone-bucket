{
    "version": "1.0.5",
    "description": "SSH configuration and private key for cube one coding VMs",
    "homepage": "https://cubeone.de",
    "license": "Proprietary",
    "url": "https://raw.githubusercontent.com/cube-one-gxp-lifescience-partner/cubeone-bucket/master/LICENSE",
    "hash": "6b0382b16279f26ff69014300541967a356a666eb0b91b422f6862f6b7dad17e",
    "installer": {
        "script": [
            "Remove-Item \"$dir\\LICENSE\" -Force -ErrorAction SilentlyContinue",
            "",
            "if (-not $env:AUTO_UPDATER_API_KEY) {",
            "    throw 'AUTO_UPDATER_API_KEY environment variable not set'",
            "}",
            "",
            "function Read-ProfilePathFile {",
            "    param([Parameter(Mandatory = $true)][string]$FilePath)",
            "",
            "    if (-not (Test-Path -LiteralPath $FilePath)) {",
            "        return ''",
            "    }",
            "",
            "    $value = [System.IO.File]::ReadAllText($FilePath).Trim()",
            "    if ($value.StartsWith([char]0xFEFF)) {",
            "        $value = $value.Substring(1).Trim()",
            "    }",
            "    if (-not $value) {",
            "        return ''",
            "    }",
            "    if (-not (Test-Path -LiteralPath $value -PathType Container)) {",
            "        return ''",
            "    }",
            "",
            "    return [System.IO.Path]::GetFullPath($value).TrimEnd('\\')",
            "}",
            "",
            "function Resolve-TargetProfilePath {",
            "    # Same files the auto-updater service uses to pick one profile on a",
            "    # multi-user machine. USERPROFILE is only the fallback (Scoop override or",
            "    # an interactive install without those files).",
            "    $fromHomeFile = Read-ProfilePathFile -FilePath 'C:\\Temp\\home'",
            "    if ($fromHomeFile) {",
            "        return $fromHomeFile",
            "    }",
            "",
            "    $fromHomeCache = Read-ProfilePathFile -FilePath 'C:\\cubeone\\auto-updater\\home.cache'",
            "    if ($fromHomeCache) {",
            "        return $fromHomeCache",
            "    }",
            "",
            "    if (-not $env:USERPROFILE) {",
            "        throw 'Could not resolve target profile: auto-updater home files missing and USERPROFILE is empty'",
            "    }",
            "",
            "    return [System.IO.Path]::GetFullPath($env:USERPROFILE).TrimEnd('\\')",
            "}",
            "",
            "function Get-SidForUserProfile {",
            "    param([Parameter(Mandatory = $true)][string]$ProfilePath)",
            "",
            "    $normalized = [System.IO.Path]::GetFullPath($ProfilePath).TrimEnd('\\')",
            "    $profileList = 'HKLM:\\SOFTWARE\\Microsoft\\Windows NT\\CurrentVersion\\ProfileList'",
            "    foreach ($key in (Get-ChildItem -Path $profileList)) {",
            "        $imagePath = (Get-ItemProperty -Path $key.PSPath).ProfileImagePath",
            "        if (-not $imagePath) {",
            "            continue",
            "        }",
            "        $expanded = [System.IO.Path]::GetFullPath(",
            "            [Environment]::ExpandEnvironmentVariables($imagePath)",
            "        ).TrimEnd('\\')",
            "        if ([string]::Equals($expanded, $normalized, [System.StringComparison]::OrdinalIgnoreCase)) {",
            "            return $key.PSChildName",
            "        }",
            "    }",
            "",
            "    throw \"Could not resolve Windows SID for profile $ProfilePath\"",
            "}",
            "",
            "$targetProfile = Resolve-TargetProfilePath",
            "$sshDirectory = Join-Path $targetProfile '.ssh'",
            "$keyPath = Join-Path $sshDirectory 'id-coding-vm'",
            "$downloadPath = Join-Path $cachedir 'id-coding-vm'",
            "$configPath = Join-Path $sshDirectory 'config'",
            "$downloadUrl = 'https://update.cubeone.de/files/c604d6a4-9be2-4251-9010-bd0b53c5c4c5'",
            "$expectedHash = '176E122F24ECB7FA48D7887CB1D6BCA3C862F2B79C1D604982F148F2C8059454'",
            "$headers = @{",
            "    'X-API-Key' = $env:AUTO_UPDATER_API_KEY",
            "    'User-Agent' = 'cube-one-auto-updater/1.0'",
            "}",
            "",
            "# coding-vm-1 is 192.168.10.250 and every following VM counts one octet",
            "# down, so coding-vm-8 ends up on 192.168.10.243.",
            "$firstVmOctet = 250",
            "$vmCount = 8",
            "",
            "$configLines = @()",
            "foreach ($vmIndex in 1..$vmCount) {",
            "    $configLines += \"Host coding-vm-$vmIndex\"",
            "    $configLines += \"    HostName 192.168.10.$($firstVmOctet - $vmIndex + 1)\"",
            "    $configLines += '    User cubeone'",
            "    $configLines += '    IdentityFile ~/.ssh/id-coding-vm'",
            "    $configLines += '    IdentitiesOnly yes'",
            "    $configLines += '    StrictHostKeyChecking accept-new'",
            "    $configLines += ''",
            "}",
            "",
            "$configLines += @(",
            "    'Host *'",
            "    '    ServerAliveInterval 30'",
            "    '    ServerAliveCountMax 10'",
            "    '    TCPKeepAlive yes'",
            "    '    ConnectTimeout 15'",
            "    '    Compression no'",
            ")",
            "",
            "function Protect-PrivateKeyFile {",
            "    param(",
            "        [Parameter(Mandatory = $true)][string]$Path,",
            "        [Parameter(Mandatory = $true)][string]$ProfilePath",
            "    )",
            "",
            "    # The principal is addressed by SID on purpose. A display name containing",
            "    # non-ASCII characters does not survive the native-command argument",
            "    # encoding, so icacls would apply the ACE to a different principal and",
            "    # lock the user out of their own key.",
            "    $sid = Get-SidForUserProfile -ProfilePath $ProfilePath",
            "    $account = New-Object System.Security.Principal.SecurityIdentifier $sid",
            "",
            "    # Ownership has to be settled first: restricting the ACL to read access",
            "    # also drops WRITE_OWNER, after which this would no longer be possible.",
            "    $acl = Get-Acl -Path $Path",
            "    $acl.SetOwner($account)",
            "    Set-Acl -Path $Path -AclObject $acl",
            "",
            "    # OpenSSH refuses a key that is reachable by anyone other than the owner,",
            "    # SYSTEM and the local Administrators group.",
            "    $null = & icacls.exe $Path /inheritance:r /grant:r \"*${sid}:(R)\" '*S-1-5-18:(F)' '*S-1-5-32-544:(F)'",
            "    if ($LASTEXITCODE -ne 0) {",
            "        throw \"Failed to restrict ACL on $Path (icacls exit $LASTEXITCODE)\"",
            "    }",
            "}",
            "",
            "function Assert-PrivateKeyUsable {",
            "    param([Parameter(Mandatory = $true)][string]$Path)",
            "",
            "    # A key that got mangled while being published (for example a lost",
            "    # trailing newline) still matches its SHA256 hash but is rejected by the",
            "    # PEM parser at connect time. Fail here instead of leaving a broken key",
            "    # behind. Win32-OpenSSH accepts only -f together with -y, so passing -P",
            "    # here would abort with 'Too many arguments'.",
            "    $sshKeygen = Join-Path $env:WINDIR 'System32\\OpenSSH\\ssh-keygen.exe'",
            "    if (-not (Test-Path $sshKeygen)) {",
            "        Write-Host 'ssh-keygen not found, skipping private key validation.' -ForegroundColor Yellow",
            "        return",
            "    }",
            "",
            "    $null = & $sshKeygen -y -f $Path 2>&1",
            "    if ($LASTEXITCODE -ne 0) {",
            "        throw \"$Path is not a valid OpenSSH private key (ssh-keygen exit $LASTEXITCODE). The published file is most likely damaged or encrypted.\"",
            "    }",
            "}",
            "",
            "try {",
            "    New-Item -ItemType Directory -Path $sshDirectory -Force | Out-Null",
            "    Remove-Item $downloadPath -Force -ErrorAction SilentlyContinue",
            "",
            "    Write-Host \"Installing coding VM SSH files for profile $targetProfile\" -ForegroundColor Blue",
            "    Write-Host 'Downloading the coding VM private key...' -ForegroundColor Blue",
            "    Invoke-WebRequest -Uri $downloadUrl -Headers $headers -OutFile $downloadPath -TimeoutSec 60 -ErrorAction Stop",
            "",
            "    $actualHash = (Get-FileHash -Path $downloadPath -Algorithm SHA256).Hash",
            "    if ($actualHash -ne $expectedHash) {",
            "        throw \"SHA256 hash mismatch for id-coding-vm. Expected: $expectedHash, Actual: $actualHash\"",
            "    }",
            "",
            "    Copy-Item -Path $downloadPath -Destination $keyPath -Force",
            "    Protect-PrivateKeyFile -Path $keyPath -ProfilePath $targetProfile",
            "    Assert-PrivateKeyUsable -Path $keyPath",
            "",
            "    $configContent = ($configLines -join [Environment]::NewLine) + [Environment]::NewLine",
            "    $utf8WithoutBom = New-Object System.Text.UTF8Encoding($false)",
            "    [System.IO.File]::WriteAllText($configPath, $configContent, $utf8WithoutBom)",
            "",
            "    Write-Host \"Private key installed at $keyPath with owner and read access for that profile.\" -ForegroundColor Green",
            "    Write-Host \"SSH configuration written to $configPath.\" -ForegroundColor Green",
            "} catch {",
            "    throw \"Failed to configure coding VM SSH access: $($_.Exception.Message)\"",
            "} finally {",
            "    Remove-Item $downloadPath -Force -ErrorAction SilentlyContinue",
            "}"
        ]
    },
    "uninstaller": {
        "script": [
            "function Read-ProfilePathFile {",
            "    param([Parameter(Mandatory = $true)][string]$FilePath)",
            "",
            "    if (-not (Test-Path -LiteralPath $FilePath)) {",
            "        return ''",
            "    }",
            "",
            "    $value = [System.IO.File]::ReadAllText($FilePath).Trim()",
            "    if ($value.StartsWith([char]0xFEFF)) {",
            "        $value = $value.Substring(1).Trim()",
            "    }",
            "    if (-not $value) {",
            "        return ''",
            "    }",
            "    if (-not (Test-Path -LiteralPath $value -PathType Container)) {",
            "        return ''",
            "    }",
            "",
            "    return [System.IO.Path]::GetFullPath($value).TrimEnd('\\')",
            "}",
            "",
            "function Resolve-TargetProfilePath {",
            "    $fromHomeFile = Read-ProfilePathFile -FilePath 'C:\\Temp\\home'",
            "    if ($fromHomeFile) {",
            "        return $fromHomeFile",
            "    }",
            "",
            "    $fromHomeCache = Read-ProfilePathFile -FilePath 'C:\\cubeone\\auto-updater\\home.cache'",
            "    if ($fromHomeCache) {",
            "        return $fromHomeCache",
            "    }",
            "",
            "    if (-not $env:USERPROFILE) {",
            "        throw 'Could not resolve target profile: auto-updater home files missing and USERPROFILE is empty'",
            "    }",
            "",
            "    return [System.IO.Path]::GetFullPath($env:USERPROFILE).TrimEnd('\\')",
            "}",
            "",
            "function Get-SidForUserProfile {",
            "    param([Parameter(Mandatory = $true)][string]$ProfilePath)",
            "",
            "    $normalized = [System.IO.Path]::GetFullPath($ProfilePath).TrimEnd('\\')",
            "    $profileList = 'HKLM:\\SOFTWARE\\Microsoft\\Windows NT\\CurrentVersion\\ProfileList'",
            "    foreach ($key in (Get-ChildItem -Path $profileList)) {",
            "        $imagePath = (Get-ItemProperty -Path $key.PSPath).ProfileImagePath",
            "        if (-not $imagePath) {",
            "            continue",
            "        }",
            "        $expanded = [System.IO.Path]::GetFullPath(",
            "            [Environment]::ExpandEnvironmentVariables($imagePath)",
            "        ).TrimEnd('\\')",
            "        if ([string]::Equals($expanded, $normalized, [System.StringComparison]::OrdinalIgnoreCase)) {",
            "            return $key.PSChildName",
            "        }",
            "    }",
            "",
            "    throw \"Could not resolve Windows SID for profile $ProfilePath\"",
            "}",
            "",
            "$targetProfile = Resolve-TargetProfilePath",
            "$sshDirectory = Join-Path $targetProfile '.ssh'",
            "$keyPath = Join-Path $sshDirectory 'id-coding-vm'",
            "$configPath = Join-Path $sshDirectory 'config'",
            "$sid = Get-SidForUserProfile -ProfilePath $targetProfile",
            "",
            "foreach ($path in @($keyPath, $configPath)) {",
            "    if (-not (Test-Path $path)) {",
            "        continue",
            "    }",
            "",
            "    # The private key is installed read-only, so regain delete rights first.",
            "    # Addressed by SID for the same reason as in the installer.",
            "    $null = & takeown.exe /F $path",
            "    $null = & icacls.exe $path /grant:r \"*${sid}:(F)\"",
            "    Remove-Item $path -Force -ErrorAction Stop",
            "",
            "    if (Test-Path $path) {",
            "        throw \"Failed to remove $path\"",
            "    }",
            "    Write-Host \"Removed $path\" -ForegroundColor Green",
            "}",
            "",
            "Write-Host 'Coding VM SSH private key and SSH config removed.' -ForegroundColor Green"
        ]
    },
    "notes": [
        "Requires the AUTO_UPDATER_API_KEY environment variable for authentication.",
        "Resolves the target profile from C:\\Temp\\home, then C:\\cubeone\\auto-updater\\home.cache, then USERPROFILE.",
        "Overwrites that profile's .ssh\\config during installation.",
        "Sets the private key owner and ACL from the ProfileList SID of that profile, not the installing process identity.",
        "Validates the installed key with ssh-keygen so a malformed download fails at install time.",
        "Connection multiplexing is deliberately absent: Win32-OpenSSH does not implement ControlMaster.",
        "Uninstall removes id-coding-vm and config from the same resolved .ssh directory."
    ]
}
