{
    "version": "1.0.0",
    "description": "ArbeitsbeginnApp - Work start application from cube one",
    "homepage": "https://cubeone.de",
    "license": "Proprietary",
    "url": "https://raw.githubusercontent.com/cube-one-gxp-lifescience-partner/cubeone-bucket/master/files/ArbeitsbeginnApp.exe",
    "hash": "6b041384870649469eeb67b41fe38ed921735205758d3e35504f0890a5cf3995",
    "shortcuts": [
        [
            "ArbeitsbeginnApp.exe",
            "ArbeitsbeginnApp"
        ]
    ],
    "post_install": [
        "$WScriptShell = New-Object -ComObject WScript.Shell",
        "$desktopPath = [Environment]::GetFolderPath('Desktop')",
        "$desktopShortcut = Join-Path $desktopPath 'ArbeitsbeginnApp.lnk'",
        "$shortcut = $WScriptShell.CreateShortcut($desktopShortcut)",
        "$shortcut.TargetPath = \"$dir\\ArbeitsbeginnApp.exe\"",
        "$shortcut.WorkingDirectory = \"$dir\"",
        "$shortcut.Description = 'ArbeitsbeginnApp'",
        "$shortcut.Save()",
        "Write-Host \"Desktop shortcut created: $desktopShortcut\" -ForegroundColor Green",
        "Write-Host 'ArbeitsbeginnApp installed successfully!' -ForegroundColor Green"
    ],
    "uninstaller": {
        "script": [
            "$desktopPath = [Environment]::GetFolderPath('Desktop')",
            "$desktopShortcut = Join-Path $desktopPath 'ArbeitsbeginnApp.lnk'",
            "if (Test-Path $desktopShortcut) {",
            "    Remove-Item $desktopShortcut -Force -ErrorAction SilentlyContinue",
            "    Write-Host \"Desktop shortcut removed: $desktopShortcut\" -ForegroundColor Green",
            "}",
            "$startMenuShortcut = Join-Path $env:APPDATA 'Microsoft\\Windows\\Start Menu\\Programs\\Scoop Apps\\ArbeitsbeginnApp.lnk'",
            "if (Test-Path $startMenuShortcut) {",
            "    Remove-Item $startMenuShortcut -Force -ErrorAction SilentlyContinue",
            "    Write-Host \"Start Menu shortcut removed: $startMenuShortcut\" -ForegroundColor Green",
            "}"
        ]
    },
    "notes": [
        "Portable application from cube one GmbH",
        "Executable is hosted in this Scoop bucket repository",
        "Creates Desktop and Start Menu shortcuts",
        "Shortcuts are removed on uninstall"
    ]
}
