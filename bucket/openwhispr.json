{
    "version":  "1.11.0",
    "description":  "OpenWhispr dictation with local Orukeet, push-to-talk on RightControl, and the ProgramData model cache.",
    "homepage":  "https://openwhispr.com/",
    "license":  "MIT",
    "notes":  [
                  "Settings stay in $persist_dir\\user-data and are linked from %APPDATA%\\open-whispr.",
                  "The speech model is stored in C:\\ProgramData\\OpenWhispr\\cache because a profile path with spaces or non-ASCII characters makes the local engine fail.",
                  "New profiles use local Orukeet v0.1.0, language auto, RightControl, push-to-talk, and OpenRouter cleanup with Claude Haiku. The window starts minimized, the panel opens in the center, and the floating icon hides itself. The setup wizard is skipped using the app's guest mode, so dictation is ready without an OpenWhispr account. Existing profiles are kept.",
                  "Updates come from scoop update. The built-in updater file is removed.",
                  "The OpenRouter key is read from HKLM\\SOFTWARE\\cubeone\\OpenWhispr, value OpenRouterApiKey. It is not part of this package. OpenWhispr encrypts it in the user profile on the next start."
              ],
    "architecture":  {
                         "64bit":  {
                                       "url":  "https://github.com/OpenWhispr/openwhispr/releases/download/v1.11.0/OpenWhispr-Setup-1.11.0.exe#/dl.7z",
                                       "hash":  "a55db275a3efa202b6e50d302746092d6b77594c89456c26bbed5a70e56fe3b9"
                                   }
                     },
    "env_set":  {
                    "OPENWHISPR_CACHE_ROOT":  "C:\\ProgramData\\OpenWhispr\\cache"
                },
    "pre_install":  [
                        "Get-CimInstance Win32_Process -ErrorAction SilentlyContinue | Where-Object { $_.ExecutablePath -and ($_.ExecutablePath -like \u0027*\\OpenWhispr\\*\u0027 -or $_.ExecutablePath -like \u0027*\\openwhispr\\*\u0027) } | ForEach-Object { Stop-Process -Id $_.ProcessId -Force -ErrorAction SilentlyContinue }",
                        "Start-Sleep -Seconds 2",
                        "Expand-7zipArchive \"$dir\\`$PLUGINSDIR\\app-64.7z\" \"$dir\"",
                        "Remove-Item -LiteralPath (Join-Path $dir \u0027$PLUGINSDIR\u0027) -Recurse -Force -ErrorAction SilentlyContinue",
                        "Remove-Item -LiteralPath (Join-Path $dir \u0027$R0\u0027) -Recurse -Force -ErrorAction SilentlyContinue",
                        "Remove-Item -Path (Join-Path $dir \u0027Uninstall*\u0027) -Force -ErrorAction SilentlyContinue"
                    ],
    "post_install":  [
                         "$ErrorActionPreference = \u0027Stop\u0027",
                         "if (-not $dir) { abort \u0027Scoop variable $dir is not set\u0027 }",
                         "if (-not $persist_dir) { abort \u0027Scoop variable $persist_dir is not set\u0027 }",
                         "",
                         "Get-CimInstance Win32_Process -ErrorAction SilentlyContinue |",
                         "    Where-Object { $_.ExecutablePath -and ($_.ExecutablePath -like \u0027*\\OpenWhispr\\*\u0027 -or $_.ExecutablePath -like \u0027*\\openwhispr\\*\u0027) } |",
                         "    ForEach-Object { Stop-Process -Id $_.ProcessId -Force -ErrorAction SilentlyContinue }",
                         "Start-Sleep -Seconds 2",
                         "",
                         "Remove-Item -LiteralPath (Join-Path $dir \u0027resources\\app-update.yml\u0027) -Force -ErrorAction SilentlyContinue",
                         "",
                         "$defaultsScript = Join-Path $dir 'cubeone-defaults.cjs'",
                         "$defaultsSource = @'",
                         "process.noAsar = true;",
                         "const fs = require('node:fs');",
                         "const crypto = require('node:crypto');",
                         "const defaults = {",
                         "  transcriptionMode: 'local',",
                         "  useLocalWhisper: 'true',",
                         "  localTranscriptionProvider: 'nvidia',",
                         "  parakeetModel: 'orukeet-v0.1.0',",
                         "  preferredLanguage: 'auto',",
                         "  dictationKey: 'RightControl',",
                         "  activationMode: 'push',",
                         "  floatingIconAutoHide: 'true',",
                         "  panelStartPosition: 'center',",
                         "  startMinimized: 'true',",
                         "  cleanupMode: 'providers',",
                         "  cleanupCloudMode: 'byok',",
                         "  cleanupProvider: 'openrouter',",
                         "  cleanupModel: '~anthropic/claude-haiku-latest',",
                         "  useCleanupModel: 'true',",
                         "  useDictationAgent: 'false',",
                         "  enterpriseSetupMode: 'manual',",
                         "  autoUpdatesEnabled: 'false',",
                         "  authenticationSkipped: 'true',",
                         "  skipAuth: 'true',",
                         "  onboardingCompleted: 'true',",
                         "};",
                         "const marker = '// cubeone-openwhispr-defaults-v2';",
                         "const seed = `${marker}\\n(() => {\\n  try {\\n    if (localStorage.length !== 0) return;\\n    const defaults = ${JSON.stringify(defaults)};\\n    for (const [key, value] of Object.entries(defaults)) localStorage.setItem(key, value);\\n  } catch {\\n    console.warn('OpenWhispr could not initialize cube one preferences.');\\n  }\\n})();\\n`;",
                         "const archivePath = process.argv[2];",
                         "const archive = fs.readFileSync(archivePath);",
                         "const headerSize = archive.readUInt32LE(4);",
                         "const bodyOffset = 8 + headerSize;",
                         "const header = JSON.parse(archive.subarray(16, 16 + archive.readUInt32LE(12)).toString('utf8'));",
                         "const entry = header.files['preload.js'];",
                         "if (!entry || entry.unpacked || entry.link) throw new Error('Unsupported OpenWhispr preload layout.');",
                         "const preload = archive.subarray(bodyOffset + Number(entry.offset), bodyOffset + Number(entry.offset) + entry.size);",
                         "if (!preload.toString('utf8').includes(marker)) {",
                         "  const original = preload.toString('utf8').replace(/^\\/\\/ cubeone-openwhispr-defaults-v[12]\\r?\\n[\\s\\S]*?\\r?\\n\\}\\)\\(\\);\\r?\\n/, '');",
                         "  const patched = Buffer.concat([Buffer.from(seed), Buffer.from(original)]);",
                         "  entry.offset = String(archive.length - bodyOffset);",
                         "  entry.size = patched.length;",
                         "  if (entry.integrity) {",
                         "    const blockSize = entry.integrity.blockSize;",
                         "    if (entry.integrity.algorithm !== 'SHA256' || !Number.isSafeInteger(blockSize) || blockSize <= 0) {",
                         "      throw new Error('Unsupported OpenWhispr preload integrity format.');",
                         "    }",
                         "    entry.integrity.hash = crypto.createHash('sha256').update(patched).digest('hex');",
                         "    entry.integrity.blocks = [];",
                         "    for (let offset = 0; offset < patched.length; offset += blockSize) {",
                         "      entry.integrity.blocks.push(crypto.createHash('sha256').update(patched.subarray(offset, offset + blockSize)).digest('hex'));",
                         "    }",
                         "  }",
                         "  const json = Buffer.from(JSON.stringify(header));",
                         "  const paddedLength = Math.ceil(json.length / 4) * 4;",
                         "  const prefix = Buffer.alloc(16 + paddedLength);",
                         "  prefix.writeUInt32LE(4, 0);",
                         "  prefix.writeUInt32LE(8 + paddedLength, 4);",
                         "  prefix.writeUInt32LE(4 + paddedLength, 8);",
                         "  prefix.writeUInt32LE(json.length, 12);",
                         "  json.copy(prefix, 16);",
                         "  const temporary = `${archivePath}.cubeone.tmp`;",
                         "  fs.writeFileSync(temporary, Buffer.concat([prefix, archive.subarray(bodyOffset), patched]));",
                         "  fs.renameSync(temporary, archivePath);",
                         "}",
                         "console.log('OpenWhispr first-start preferences installed.');",
                         "'@",
                         "$utf8 = New-Object System.Text.UTF8Encoding $false",
                         "[System.IO.File]::WriteAllText($defaultsScript, $defaultsSource, $utf8)",
                         "$savedRunAsNode = $env:ELECTRON_RUN_AS_NODE",
                         "try {",
                         "    $env:ELECTRON_RUN_AS_NODE = '1'",
                         "    $defaultsArgs = '\"{0}\" \"{1}\"' -f $defaultsScript, (Join-Path $dir 'resources\\app.asar')",
                         "    $defaultsProcess = Start-Process -FilePath (Join-Path $dir 'OpenWhispr.exe') -ArgumentList $defaultsArgs -Wait -PassThru -NoNewWindow",
                         "    if ($defaultsProcess.ExitCode -ne 0) { abort 'OpenWhispr preference initialization failed.' }",
                         "} finally {",
                         "    $env:ELECTRON_RUN_AS_NODE = $savedRunAsNode",
                         "    Remove-Item -LiteralPath $defaultsScript -Force -ErrorAction SilentlyContinue",
                         "}",
                         "",
                         "$persistUser = Join-Path $persist_dir \u0027user-data\u0027",
                         "New-Item -ItemType Directory -Path $persistUser -Force | Out-Null",
                         "$userData = Join-Path $env:APPDATA \u0027open-whispr\u0027",
                         "if (Test-Path -LiteralPath $userData) {",
                         "    $existing = Get-Item -Force -LiteralPath $userData",
                         "    $isLink = [bool]($existing.Attributes -band [System.IO.FileAttributes]::ReparsePoint)",
                         "    if (-not $isLink) {",
                         "        Get-ChildItem -Force -LiteralPath $userData | ForEach-Object {",
                         "            $destination = Join-Path $persistUser $_.Name",
                         "            if (-not (Test-Path -LiteralPath $destination)) {",
                         "                Move-Item -LiteralPath $_.FullName -Destination $persistUser",
                         "            }",
                         "        }",
                         "        $leftBehind = @(Get-ChildItem -Force -LiteralPath $userData)",
                         "        if ($leftBehind.Count -eq 0) {",
                         "            Remove-Item -LiteralPath $userData -Force",
                         "        } else {",
                         "            Write-Host \u0027OpenWhispr settings could not be moved completely. The original profile stays in place.\u0027",
                         "        }",
                         "    }",
                         "}",
                         "if (-not (Test-Path -LiteralPath $userData)) {",
                         "    New-Item -ItemType Junction -Path $userData -Target $persistUser | Out-Null",
                         "}",
                         "",
                         "$envPath = Join-Path $persistUser \u0027.env\u0027",
                         "if (-not (Test-Path -LiteralPath $envPath)) {",
                         "    $envLines = @(",
                         "        \u0027# OpenWhispr Environment Variables\u0027",
                         "        \u0027LOCAL_TRANSCRIPTION_PROVIDER=nvidia\u0027",
                         "        \u0027PARAKEET_MODEL=orukeet-v0.1.0\u0027",
                         "        \u0027DICTATION_LANGUAGE=auto\u0027",
                         "        \u0027DICTATION_KEY=RightControl\u0027",
                         "        \u0027ACTIVATION_MODE=push\u0027",
                         "        \u0027FLOATING_ICON_AUTO_HIDE=true\u0027",
                         "        \u0027PANEL_START_POSITION=center\u0027",
                         "        \u0027START_MINIMIZED=true\u0027",
                         "    )",
                         "    $utf8 = New-Object System.Text.UTF8Encoding $false",
                         "    [System.IO.File]::WriteAllText($envPath, ($envLines -join \"`r`n\") + \"`r`n\", $utf8)",
                         "    Write-Host \u0027OpenWhispr default dictation settings written.\u0027",
                         "}",
                         "",
                         "$regBase = [Microsoft.Win32.RegistryKey]::OpenBaseKey(\u0027LocalMachine\u0027, [Microsoft.Win32.RegistryView]::Registry64)",
                         "$regSub = $regBase.OpenSubKey(\u0027SOFTWARE\\cubeone\\OpenWhispr\u0027)",
                         "$apiKey = \u0027\u0027",
                         "if ($regSub) {",
                         "    $rawKey = $regSub.GetValue(\u0027OpenRouterApiKey\u0027)",
                         "    if ($null -ne $rawKey) { $apiKey = ([string]$rawKey).Trim() }",
                         "    $regSub.Close()",
                         "}",
                         "$regBase.Close()",
                         "if ($apiKey -match \u0027[\\r\\n]\u0027) { abort \u0027OpenRouter registry value must be a single line.\u0027 }",
                         "if ($apiKey) {",
                         "    $envLines = @()",
                         "    if (Test-Path -LiteralPath $envPath) { $envLines = @(Get-Content -LiteralPath $envPath) }",
                         "    $replaced = $false",
                         "    for ($i = 0; $i -lt $envLines.Count; $i++) {",
                         "        if ($envLines[$i] -match \u0027^\\s*OPENROUTER_API_KEY=\u0027) {",
                         "            $envLines[$i] = \u0027OPENROUTER_API_KEY=\u0027 + $apiKey",
                         "            $replaced = $true",
                         "        }",
                         "    }",
                         "    if (-not $replaced) { $envLines += \u0027OPENROUTER_API_KEY=\u0027 + $apiKey }",
                         "    $utf8 = New-Object System.Text.UTF8Encoding $false",
                         "    [System.IO.File]::WriteAllText($envPath, ($envLines -join \"`r`n\") + \"`r`n\", $utf8)",
                         "    $sentinel = Join-Path $persistUser \u0027secure-keys\\.migrated\u0027",
                         "    if (Test-Path -LiteralPath $sentinel) { Remove-Item -LiteralPath $sentinel -Force }",
                         "    Remove-Variable apiKey, rawKey -ErrorAction SilentlyContinue",
                         "    Write-Host \u0027OpenRouter key taken from the registry. OpenWhispr encrypts it on the next start.\u0027",
                         "}",
                         "",
                         "$cacheRoot = \u0027C:\\ProgramData\\OpenWhispr\\cache\u0027",
                         "$modelDir = Join-Path $cacheRoot \u0027parakeet-models\\orukeet-v0.1.0\u0027",
                         "New-Item -ItemType Directory -Path $modelDir -Force | Out-Null",
                         "$expected = @{",
                         "    \u0027encoder.int8.onnx\u0027 = [int64]653182378",
                         "    \u0027decoder.int8.onnx\u0027 = [int64]11845332",
                         "    \u0027joiner.int8.onnx\u0027 = [int64]6355335",
                         "    \u0027tokens.txt\u0027 = [int64]93939",
                         "    \u0027bpe.vocab\u0027 = [int64]117408",
                         "    \u0027LICENSE-WEIGHTS\u0027 = [int64]20137",
                         "    \u0027NOTICE.md\u0027 = [int64]5271",
                         "}",
                         "$encoderHash = \u00277b55f2a504a20a8e462899f5befd45f4a1784948d76ed0127902d9cf39405487\u0027",
                         "function Test-OrukeetFiles {",
                         "    foreach ($name in $expected.Keys) {",
                         "        $path = Join-Path $modelDir $name",
                         "        if (-not (Test-Path -LiteralPath $path -PathType Leaf)) { return $false }",
                         "        if ((Get-Item -LiteralPath $path).Length -ne $expected[$name]) { return $false }",
                         "    }",
                         "    return $true",
                         "}",
                         "$ready = Test-OrukeetFiles",
                         "if ($ready) {",
                         "    Write-Host \u0027Verifying Orukeet encoder...\u0027",
                         "    $actual = (Get-FileHash -LiteralPath (Join-Path $modelDir \u0027encoder.int8.onnx\u0027) -Algorithm SHA256).Hash.ToLowerInvariant()",
                         "    if ($actual -ne $encoderHash) {",
                         "        Write-Host \"Orukeet encoder hash is $actual\"",
                         "        $ready = $false",
                         "    }",
                         "}",
                         "if (-not $ready) {",
                         "    Write-Host \u0027Downloading Orukeet v0.1.0 (about 464 MB)...\u0027",
                         "    $archive = Join-Path $env:TEMP \u0027sherpa-onnx-orukeet-v0.1.0-int8.tar.bz2\u0027",
                         "    $url = \u0027https://huggingface.co/oruk/orukeet/resolve/55a984d46f68323301837194ce647c702f55facc/onnx/sherpa-onnx-orukeet-v0.1.0-int8.tar.bz2\u0027",
                         "    \u0026 curl.exe -L --fail --retry 3 --retry-delay 2 -o $archive $url",
                         "    if ($LASTEXITCODE -ne 0) { abort \"Orukeet download failed (curl exit $LASTEXITCODE)\" }",
                         "    $archiveHash = (Get-FileHash -LiteralPath $archive -Algorithm SHA256).Hash.ToLowerInvariant()",
                         "    if ($archiveHash -ne \u0027f9191f30178cc9122ce2f023bf9fefafc822028307b0efa4caff645ba3fe8d0a\u0027) {",
                         "        Remove-Item -LiteralPath $archive -Force -ErrorAction SilentlyContinue",
                         "        abort \"Orukeet archive SHA256 mismatch: $archiveHash\"",
                         "    }",
                         "    $extract = Join-Path $env:TEMP \u0027ow-orukeet-extract\u0027",
                         "    if (Test-Path -LiteralPath $extract) { Remove-Item -LiteralPath $extract -Recurse -Force }",
                         "    New-Item -ItemType Directory -Path $extract | Out-Null",
                         "    \u0026 tar.exe -xjf $archive -C $extract",
                         "    if ($LASTEXITCODE -ne 0) { abort \"Orukeet archive extraction failed (tar exit $LASTEXITCODE)\" }",
                         "    $inner = Join-Path $extract \u0027sherpa-onnx-orukeet-v0.1.0-int8\u0027",
                         "    if (-not (Test-Path -LiteralPath $inner -PathType Container)) { abort \u0027Orukeet archive did not contain the expected folder\u0027 }",
                         "    Get-ChildItem -LiteralPath $inner -Force | ForEach-Object {",
                         "        Copy-Item -LiteralPath $_.FullName -Destination (Join-Path $modelDir $_.Name) -Force",
                         "    }",
                         "    Remove-Item -LiteralPath $archive -Force -ErrorAction SilentlyContinue",
                         "    Remove-Item -LiteralPath $extract -Recurse -Force -ErrorAction SilentlyContinue",
                         "    $ready = Test-OrukeetFiles",
                         "}",
                         "if (-not $ready) { abort \"Orukeet model is incomplete in $modelDir\" }",
                         "Write-Host \"Orukeet model ready in $modelDir\"",
                         "",
                         "$shortcutPath = Join-Path $env:APPDATA \u0027Microsoft\\Windows\\Start Menu\\Programs\\OpenWhispr.lnk\u0027",
                         "if (Test-Path -LiteralPath $shortcutPath) {",
                         "    $shell = New-Object -ComObject WScript.Shell",
                         "    $shortcut = $shell.CreateShortcut($shortcutPath)",
                         "    if ($shortcut.TargetPath -like \u0027*\\Programs\\OpenWhispr\\OpenWhispr.exe\u0027) {",
                         "        $shortcut.TargetPath = Join-Path $dir \u0027OpenWhispr.exe\u0027",
                         "        $shortcut.WorkingDirectory = $dir",
                         "        $shortcut.Save()",
                         "        Write-Host \u0027Existing OpenWhispr shortcut now starts the Scoop installation.\u0027",
                         "    }",
                         "}",
                         "",
                         "# Existing profiles may have intentionally changed the first-start defaults.",
                         "if (-not (Test-Path -LiteralPath (Join-Path $dir \u0027OpenWhispr.exe\u0027) -PathType Leaf)) { abort \u0027OpenWhispr.exe was not found after extraction\u0027 }",
                         "Write-Host \"OpenWhispr settings: $userData\"",
                         "Write-Host \"OpenWhispr model cache: $cacheRoot\"",
                         ""
                     ],
    "pre_uninstall":  [
                          "Get-CimInstance Win32_Process -ErrorAction SilentlyContinue | Where-Object { $_.ExecutablePath -and ($_.ExecutablePath -like \u0027*\\OpenWhispr\\*\u0027 -or $_.ExecutablePath -like \u0027*\\openwhispr\\*\u0027) } | ForEach-Object { Stop-Process -Id $_.ProcessId -Force -ErrorAction SilentlyContinue }",
                          "Start-Sleep -Seconds 2"
                      ],
    "uninstaller":  {
                        "script":  [
                                       "$userData = Join-Path $env:APPDATA \u0027open-whispr\u0027",
                                       "$item = Get-Item -Force -LiteralPath $userData -ErrorAction SilentlyContinue",
                                       "if ($item -and ($item.Attributes -band [System.IO.FileAttributes]::ReparsePoint)) {",
                                       "    cmd.exe /c rmdir \"$userData\"",
                                       "}"
                                   ]
                    },
    "bin":  "OpenWhispr.exe",
    "shortcuts":  [
                      [
                          "OpenWhispr.exe",
                          "OpenWhispr"
                      ]
                  ],
    "checkver":  {
                     "github":  "https://github.com/OpenWhispr/openwhispr"
                 },
    "autoupdate":  {
                       "architecture":  {
                                            "64bit":  {
                                                          "url":  "https://github.com/OpenWhispr/openwhispr/releases/download/v$version/OpenWhispr-Setup-$version.exe#/dl.7z"
                                                      }
                                        }
                   }
}
