// Managed by the cubeone-bucket opencode-desktop manifest. Do not edit on the machine.
// Regenerate with scripts\opencode-cubeone\Update-OpenCodeModels.ps1.
// Model list checked against https://openrouter.ai/api/v1/endpoints/zdr on 2026-11-01. EU endpoints are pinned where one exists.
{
  "$schema": "https://opencode.ai/config.json",
  "update": "disable",
  "share": "disabled",
  "websearch": {
    "provider": "cubeone-zdr"
  },
  "model": "openrouter-zdr/anthropic/claude-sonnet-5.5",
  "providers": {
    "openrouter-zdr": {
      "name": "OpenRouter (ZDR)",
      "package": "@opencode/ai/providers/openrouter",
      "env": [
        "OPENROUTER_API_KEY"
      ],
      "settings": {
        "baseURL": "https://openrouter.ai/api/v1"
      },
      "headers": {
        "HTTP-Referer": "https://cubeone.de",
        "X-Title": "OpenCode cube one"
      },
      "body": {
        "provider": {
          "zdr": true,
          "data_collection": "deny"
        }
      },
