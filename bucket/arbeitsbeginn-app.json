{
    "version": "1.1.1",
    "description": "ArbeitsbeginnApp - Work start application from cube one",
    "homepage": "https://cubeone.de",
    "license": "Proprietary",
    "url": "https://raw.githubusercontent.com/cube-one-gxp-lifescience-partner/cubeone-bucket/master/LICENSE",
    "hash": "6b0382b16279f26ff69014300541967a356a666eb0b91b422f6862f6b7dad17e",
    "shortcuts": [
        [
            "ArbeitsbeginnApp.exe",
            "ArbeitsbeginnApp"
        ]
    ],
    "pre_install": [
        "Remove-Item \"$dir\\LICENSE\" -ErrorAction SilentlyContinue",
        "",
        "if (-not $env:AUTO_UPDATER_API_KEY) {",
        "    throw 'AUTO_UPDATER_API_KEY environment variable not set'",
        "}",
        "",
        "Write-Host 'Downloading ArbeitsbeginnApp from cube one update server...' -ForegroundColor Blue",
        "",
        "$headers = @{",
        "    'X-API-Key' = $env:AUTO_UPDATER_API_KEY",
        "    'User-Agent' = 'cube-one-auto-updater/1.0'",
        "}",
        "",
        "$downloadUrl = 'https://update.cubeone.de/files/8eae1a7f-81ad-4650-865d-2dd6560435e4'",
        "$downloadPath = \"$cachedir\\ArbeitsbeginnApp.exe\"",
        "",
        "try {",
        "    Invoke-WebRequest -Uri $downloadUrl -Headers $headers -OutFile $downloadPath -TimeoutSec 120",
        "",
        "    if (-not (Test-Path $downloadPath)) {",
        "        throw 'Downloaded file not found'",
        "    }",
        "",
        "    $fileInfo = Get-Item $downloadPath",
        "    Write-Host \"Download successful: $($fileInfo.Length) bytes\" -ForegroundColor Green",
        "",
        "    $expectedHash = 'F93FFE6CB665D58AF857C51880FD1A0F6880A8AF5FD49B121B3D034645619C15'",
        "    $actualHash = (Get-FileHash -Path $downloadPath -Algorithm SHA256).Hash",
        "    if ($actualHash -ne $expectedHash) {",
        "        throw \"SHA256 hash mismatch for ArbeitsbeginnApp.exe. Expected: $expectedHash, Actual: $actualHash\"",
        "    }",
        "    Write-Host 'SHA256 hash verified for ArbeitsbeginnApp.exe' -ForegroundColor Green",
        "",
        "    Copy-Item -Path $downloadPath -Destination \"$dir\\ArbeitsbeginnApp.exe\" -Force",
        "} catch {",
        "    throw \"Failed to download ArbeitsbeginnApp: $($_.Exception.Message)\"",
        "} finally {",
        "    Remove-Item $downloadPath -ErrorAction SilentlyContinue",
        "}"
    ],
    "post_install": [
        "if (-not (Test-Path \"$dir\\ArbeitsbeginnApp.exe\")) {",
        "    throw 'ArbeitsbeginnApp.exe not found'",
        "}",
        "",
        "$desktopPath = [Environment]::GetFolderPath('DesktopDirectory')",
        "if ([string]::IsNullOrWhiteSpace($desktopPath)) { $desktopPath = [Environment]::GetFolderPath('Desktop') }",
        "if ([string]::IsNullOrWhiteSpace($desktopPath)) {",
        "    $shellDesktop = (Get-ItemProperty -Path 'HKCU:\\Software\\Microsoft\\Windows\\CurrentVersion\\Explorer\\User Shell Folders' -ErrorAction SilentlyContinue).Desktop",
        "    if ($shellDesktop) { $desktopPath = [Environment]::ExpandEnvironmentVariables([string]$shellDesktop) }",
        "}",
        "if ([string]::IsNullOrWhiteSpace($desktopPath) -and $env:USERPROFILE) { $desktopPath = Join-Path $env:USERPROFILE 'Desktop' }",
        "if ([string]::IsNullOrWhiteSpace($desktopPath)) {",
        "    Write-Host 'Desktop folder not found, skipping desktop shortcut.' -ForegroundColor Yellow",
        "} else {",
        "    $desktopShortcut = Join-Path $desktopPath 'ArbeitsbeginnApp.lnk'",
        "    $WScriptShell = New-Object -ComObject WScript.Shell",
        "    $shortcut = $WScriptShell.CreateShortcut($desktopShortcut)",
        "    $shortcut.TargetPath = \"$dir\\ArbeitsbeginnApp.exe\"",
        "    $shortcut.WorkingDirectory = \"$dir\"",
        "    $shortcut.Description = 'ArbeitsbeginnApp'",
        "    $shortcut.Save()",
        "    Write-Host \"Desktop shortcut created: $desktopShortcut\" -ForegroundColor Green",
        "}",
        "Write-Host 'ArbeitsbeginnApp installed successfully!' -ForegroundColor Green"
    ],
    "uninstaller": {
        "script": [
            "$desktopPath = [Environment]::GetFolderPath('DesktopDirectory')",
            "if ([string]::IsNullOrWhiteSpace($desktopPath)) { $desktopPath = [Environment]::GetFolderPath('Desktop') }",
            "if ([string]::IsNullOrWhiteSpace($desktopPath)) {",
            "    $shellDesktop = (Get-ItemProperty -Path 'HKCU:\\Software\\Microsoft\\Windows\\CurrentVersion\\Explorer\\User Shell Folders' -ErrorAction SilentlyContinue).Desktop",
            "    if ($shellDesktop) { $desktopPath = [Environment]::ExpandEnvironmentVariables([string]$shellDesktop) }",
            "}",
            "if ([string]::IsNullOrWhiteSpace($desktopPath) -and $env:USERPROFILE) { $desktopPath = Join-Path $env:USERPROFILE 'Desktop' }",
            "if (-not [string]::IsNullOrWhiteSpace($desktopPath)) {",
            "    $desktopShortcut = Join-Path $desktopPath 'ArbeitsbeginnApp.lnk'",
            "    if (Test-Path -LiteralPath $desktopShortcut) {",
            "        Remove-Item -LiteralPath $desktopShortcut -Force -ErrorAction SilentlyContinue",
            "        Write-Host \"Desktop shortcut removed: $desktopShortcut\" -ForegroundColor Green",
            "    }",
            "}",
            "if ($env:APPDATA) {",
            "    $startMenuShortcut = Join-Path $env:APPDATA 'Microsoft\\Windows\\Start Menu\\Programs\\Scoop Apps\\ArbeitsbeginnApp.lnk'",
            "    if (Test-Path -LiteralPath $startMenuShortcut) {",
            "        Remove-Item -LiteralPath $startMenuShortcut -Force -ErrorAction SilentlyContinue",
            "        Write-Host \"Start Menu shortcut removed: $startMenuShortcut\" -ForegroundColor Green",
            "    }",
            "}"
        ]
    },
    "notes": [
        "Portable application from cube one GmbH",
        "Downloaded from update.cubeone.de",
        "Requires AUTO_UPDATER_API_KEY environment variable for authentication",
        "SHA256 hash verified for ArbeitsbeginnApp.exe after download",
        "Creates Desktop and Start Menu shortcuts",
        "Shortcuts are removed on uninstall"
    ]
}
