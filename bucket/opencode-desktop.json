{
    "version": "2.3.0",
    "description": "OpenCode Desktop application and CLI",
    "homepage": "https://opencode.ai",
    "license": "MIT",
    "architecture": {
        "64bit": {
            "url": "https://opencode.ai/files/bin/2.3.0/opencode-desktop-win-x64.exe#/dl.7z",
            "hash": "21e4d45dd957ebe92d3ea693fc4a7f7bb5b50276046bf7b78767081dd37d685e"
        }
    },
    "installer": {
        "script": [
            "Expand-7zipArchive \"$dir\\`$PLUGINSDIR\\app-64.7z\" \"$dir\"",
            "Remove-Item \"$dir\\`$PLUGINSDIR\", \"$dir\\`$R0\" -Recurse -Force -ErrorAction SilentlyContinue",
            "Remove-Item \"$dir\\Uninstall OpenCode.exe\", \"$dir\\resources\\app-update.yml\" -Force -ErrorAction SilentlyContinue"
        ]
    },
    "bin": [
        [
            "resources\\opencode-cli.exe",
            "opencode"
        ]
    ],
    "shortcuts": [
        [
            "OpenCode.exe",
            "OpenCode"
        ]
    ],
    "checkver": {
        "url": "https://opencode.ai/update/api/latest/desktop/opencode/latest.yml",
        "regex": "version:\\s*([\\d.]+)"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://opencode.ai/files/bin/$version/opencode-desktop-win-x64.exe#/dl.7z"
            }
        }
    }
}
