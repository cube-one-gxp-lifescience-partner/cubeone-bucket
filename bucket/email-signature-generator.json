{
    "version": "1.0.0",
    "description": "Email Signature Generator from cube one",
    "homepage": "https://cubeone.de",
    "license": "Proprietary",
    "url": "https://raw.githubusercontent.com/cube-one-gxp-lifescience-partner/cubeone-bucket/master/LICENSE",
    "hash": "6b0382b16279f26ff69014300541967a356a666eb0b91b422f6862f6b7dad17e",
    "bin": "email_signature_generator.exe",
    "shortcuts": [
        [
            "email_signature_generator.exe",
            "Email Signature Generator"
        ]
    ],
    "pre_install": [
        "Remove-Item \"$dir\\LICENSE\" -ErrorAction SilentlyContinue",
        "",
        "if (-not $env:AUTO_UPDATER_API_KEY) {",
        "    throw 'AUTO_UPDATER_API_KEY environment variable not set'",
        "}",
        "",
        "Write-Host 'Downloading Email Signature Generator from cube one update server...' -ForegroundColor Blue",
        "",
        "$headers = @{",
        "    'X-API-Key' = $env:AUTO_UPDATER_API_KEY",
        "    'User-Agent' = 'cube-one-auto-updater/1.0'",
        "}",
        "",
        "$downloadUrl = 'https://update.cubeone.de/files/d5b064d6-a1dc-4510-9172-ab47f5064129'",
        "$downloadPath = \"$cachedir\\email_signature_generator.exe\"",
        "",
        "try {",
        "    Invoke-WebRequest -Uri $downloadUrl -Headers $headers -OutFile $downloadPath -TimeoutSec 120",
        "",
        "    if (-not (Test-Path $downloadPath)) {",
        "        throw 'Downloaded file not found'",
        "    }",
        "",
        "    $fileInfo = Get-Item $downloadPath",
        "    Write-Host \"Download successful: $($fileInfo.Length) bytes\" -ForegroundColor Green",
        "",
        "    $expectedHash = 'B1BEDF46A7C69E97BFEE142D5FCD43200A0749C0AA0650C00FA436ABB32F1EFA'",
        "    $actualHash = (Get-FileHash -Path $downloadPath -Algorithm SHA256).Hash",
        "    if ($actualHash -ne $expectedHash) {",
        "        throw \"SHA256 hash mismatch for email_signature_generator.exe. Expected: $expectedHash, Actual: $actualHash\"",
        "    }",
        "    Write-Host 'SHA256 hash verified for email_signature_generator.exe' -ForegroundColor Green",
        "",
        "    Copy-Item -Path $downloadPath -Destination \"$dir\\email_signature_generator.exe\" -Force",
        "} catch {",
        "    throw \"Failed to download Email Signature Generator: $($_.Exception.Message)\"",
        "}",
        "",
        "Remove-Item $downloadPath -ErrorAction SilentlyContinue"
    ],
    "post_install": [
        "if (-not (Test-Path \"$dir\\email_signature_generator.exe\")) {",
        "    throw 'email_signature_generator.exe not found'",
        "}",
        "",
        "Write-Host 'Downloading names.json from cube one update server...' -ForegroundColor Blue",
        "",
        "$headers = @{",
        "    'X-API-Key' = $env:AUTO_UPDATER_API_KEY",
        "    'User-Agent' = 'cube-one-auto-updater/1.0'",
        "}",
        "",
        "$namesUrl = 'https://update.cubeone.de/files/78ec7dc2-759d-4d1a-9785-fc636562d195'",
        "$namesDownloadPath = \"$cachedir\\names.json\"",
        "$appdataDir = Join-Path $env:APPDATA 'cube one'",
        "$namesTargetPath = Join-Path $appdataDir 'names.json'",
        "",
        "try {",
        "    Invoke-WebRequest -Uri $namesUrl -Headers $headers -OutFile $namesDownloadPath -TimeoutSec 60",
        "",
        "    if (-not (Test-Path $namesDownloadPath)) {",
        "        throw 'Downloaded names.json not found'",
        "    }",
        "",
        "    $expectedNamesHash = '6A0DC9E2B1604E81DBD8FF2FEAB99F5E9E85CF082A2C79A6B6088C095BB96D45'",
        "    $actualNamesHash = (Get-FileHash -Path $namesDownloadPath -Algorithm SHA256).Hash",
        "    if ($actualNamesHash -ne $expectedNamesHash) {",
        "        Remove-Item $namesDownloadPath -Force -ErrorAction SilentlyContinue",
        "        throw \"SHA256 hash mismatch for names.json. Expected: $expectedNamesHash, Actual: $actualNamesHash\"",
        "    }",
        "    Write-Host 'SHA256 hash verified for names.json' -ForegroundColor Green",
        "",
        "    if (-not (Test-Path $appdataDir)) {",
        "        New-Item -ItemType Directory -Path $appdataDir -Force | Out-Null",
        "        Write-Host \"Created directory: $appdataDir\" -ForegroundColor Green",
        "    }",
        "",
        "    Copy-Item -Path $namesDownloadPath -Destination $namesTargetPath -Force",
        "    Write-Host \"names.json installed to: $namesTargetPath\" -ForegroundColor Green",
        "} catch {",
        "    throw \"Failed to install names.json: $($_.Exception.Message)\"",
        "} finally {",
        "    Remove-Item $namesDownloadPath -ErrorAction SilentlyContinue",
        "}",
        "",
        "Write-Host 'Email Signature Generator installed successfully!' -ForegroundColor Green"
    ],
    "notes": [
        "Portable application from cube one GmbH",
        "Downloaded from update.cubeone.de",
        "Requires AUTO_UPDATER_API_KEY environment variable for authentication",
        "names.json is deployed to %APPDATA%\\cube one\\names.json"
    ]
}
