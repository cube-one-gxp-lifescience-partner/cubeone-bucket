{
    "version": "1.5.0.1",
    "description": "RustDesk remote desktop with cube one self-hosted server configuration and Windows service",
    "homepage": "https://github.com/rustdesk/rustdesk",
    "license": "AGPL-3.0-only",
    "notes": [
        "Administrator privileges required",
        "Requires RUSTDESK_SETUP_KEY environment variable (Export Server Config string)",
        "Installs to Program Files with Windows service to avoid portable UAC/elevation issues",
        "Existing device ID and permanent password in %APPDATA%\\RustDesk are preserved on install and update",
        "Uninstall other RustDesk Scoop packages (e.g. extras/rustdesk) before installing this manifest",
        "Older installs are named RustDesk.exe and may live in Program Files, Program Files (x86), ProgramData, or %LOCALAPPDATA%\\RustDesk. The Windows service can keep running that older file.",
        "Install fails unless the RustDesk service is running the Program Files binary of this version"
    ],
    "architecture": {
        "64bit": {
            "url": "https://github.com/rustdesk/rustdesk/releases/download/1.5.0/rustdesk-1.5.0-x86_64.exe#/rustdesk-installer.exe",
            "hash": "8555777215510d83d2d61c9dc984e4fcc838bd7e79f9d18a42585431f5e8bb47"
        },
        "32bit": {
            "url": "https://github.com/rustdesk/rustdesk/releases/download/1.5.0/rustdesk-1.5.0-x86-sciter.exe#/rustdesk-installer.exe",
            "hash": "9f5e99ed33c08d3f61dd4e3d0dc06b927836bb518acd7047ffb0a68b9b138bf0"
        }
    },
    "pre_install": [
        "Write-Host 'Stopping RustDesk before install or update...' -ForegroundColor Yellow",
        "Stop-Service -Name 'RustDesk' -Force -ErrorAction SilentlyContinue",
        "Get-Process -Name 'rustdesk', 'RustDesk' -ErrorAction SilentlyContinue | Stop-Process -Force -ErrorAction SilentlyContinue",
        "Start-Sleep -Seconds 2"
    ],
    "installer": {
        "script": [
            "$installerPath = \"$dir\\rustdesk-installer.exe\"",
            "if (-not (Test-Path -LiteralPath $installerPath)) {",
            "    throw 'RustDesk installer not found'",
            "}",
            "",
            "# Scoop revision 1.5.0.1 still installs RustDesk 1.5.0. Compare the product version.",
            "$expectedVersion = $version",
            "if ($expectedVersion -match '^(\\d+\\.\\d+\\.\\d+)') {",
            "    $expectedVersion = $Matches[1]",
            "}",
            "",
            "function Get-RustDeskProductVersion {",
            "    param([Parameter(Mandatory = $true)][string]$Path)",
            "    if (-not (Test-Path -LiteralPath $Path -PathType Leaf)) {",
            "        return ''",
            "    }",
            "    $info = [System.Diagnostics.FileVersionInfo]::GetVersionInfo($Path)",
            "    $raw = $info.ProductVersion",
            "    if (-not $raw) {",
            "        $raw = $info.FileVersion",
            "    }",
            "    if (-not $raw) {",
            "        return ''",
            "    }",
            "    if ($raw -match '(\\d+\\.\\d+\\.\\d+)') {",
            "        return $Matches[1]",
            "    }",
            "    return $raw.Trim()",
            "}",
            "",
            "function Get-ExecutableFromCommandLine {",
            "    param([string]$CommandLine)",
            "    if (-not $CommandLine) {",
            "        return ''",
            "    }",
            "    $trimmed = $CommandLine.Trim()",
            "    if ($trimmed.StartsWith('\"')) {",
            "        $end = $trimmed.IndexOf('\"', 1)",
            "        if ($end -gt 1) {",
            "            return $trimmed.Substring(1, $end - 1)",
            "        }",
            "    }",
            "    $exeIndex = $trimmed.ToLowerInvariant().IndexOf('.exe')",
            "    if ($exeIndex -ge 0) {",
            "        return $trimmed.Substring(0, $exeIndex + 4).Trim('\"')",
            "    }",
            "    return ''",
            "}",
            "",
            "function Add-RustDeskPath {",
            "    param($List, [string]$Path)",
            "    if (-not $Path) {",
            "        return",
            "    }",
            "    $Path = $Path.Trim().Trim('\"')",
            "    if (-not (Test-Path -LiteralPath $Path -PathType Leaf)) {",
            "        return",
            "    }",
            "    $full = [System.IO.Path]::GetFullPath($Path)",
            "    foreach ($item in $List) {",
            "        if ([string]::Equals($item, $full, [System.StringComparison]::OrdinalIgnoreCase)) {",
            "            return",
            "        }",
            "    }",
            "    [void]$List.Add($full)",
            "}",
            "",
            "function Get-RustDeskCandidatePaths {",
            "    # 1.1.x installed RustDesk.exe via NSIS into Program Files.",
            "    # 1.2.x-1.4.x also landed in Program Files (x86), ProgramData and",
            "    # %LOCALAPPDATA%\\RustDesk. The service binPath keeps that older exe.",
            "    $paths = New-Object System.Collections.Generic.List[string]",
            "    $directories = @(",
            "        (Join-Path $env:ProgramFiles 'RustDesk'),",
            "        (Join-Path ${env:ProgramFiles(x86)} 'RustDesk'),",
            "        (Join-Path $env:ProgramData 'RustDesk'),",
            "        (Join-Path $env:LOCALAPPDATA 'RustDesk')",
            "    )",
            "    foreach ($directory in $directories) {",
            "        if (-not $directory) {",
            "            continue",
            "        }",
            "        foreach ($name in @('rustdesk.exe', 'RustDesk.exe')) {",
            "            Add-RustDeskPath -List $paths -Path (Join-Path $directory $name)",
            "        }",
            "    }",
            "",
            "    $service = Get-CimInstance Win32_Service -Filter \"Name='RustDesk'\" -ErrorAction SilentlyContinue",
            "    if ($service) {",
            "        Add-RustDeskPath -List $paths -Path (Get-ExecutableFromCommandLine $service.PathName)",
            "    }",
            "",
            "    $uninstallRoots = @(",
            "        'HKLM:\\Software\\Microsoft\\Windows\\CurrentVersion\\Uninstall\\*',",
            "        'HKLM:\\Software\\WOW6432Node\\Microsoft\\Windows\\CurrentVersion\\Uninstall\\*'",
            "    )",
            "    foreach ($root in $uninstallRoots) {",
            "        Get-ItemProperty -Path $root -ErrorAction SilentlyContinue |",
            "            Where-Object { $_.DisplayName -like 'RustDesk*' -or $_.PSChildName -like 'RustDesk*' } |",
            "            ForEach-Object {",
            "                foreach ($value in @($_.InstallLocation, $_.DisplayIcon, $_.UninstallString)) {",
            "                    if (-not $value) {",
            "                        continue",
            "                    }",
            "                    $text = [string]$value",
            "                    $exe = Get-ExecutableFromCommandLine $text",
            "                    if ($exe) {",
            "                        Add-RustDeskPath -List $paths -Path $exe",
            "                    } elseif (Test-Path -LiteralPath $text.TrimEnd('\\') -PathType Container) {",
            "                        foreach ($name in @('rustdesk.exe', 'RustDesk.exe')) {",
            "                            Add-RustDeskPath -List $paths -Path (Join-Path $text.TrimEnd('\\') $name)",
            "                        }",
            "                    }",
            "                }",
            "            }",
            "    }",
            "",
            "    Get-Process -Name 'rustdesk', 'RustDesk' -ErrorAction SilentlyContinue | ForEach-Object {",
            "        Add-RustDeskPath -List $paths -Path $_.Path",
            "    }",
            "    return @($paths)",
            "}",
            "",
            "function Stop-RustDeskProcesses {",
            "    Stop-Service -Name 'RustDesk' -Force -ErrorAction SilentlyContinue",
            "    Get-Process -Name 'rustdesk', 'RustDesk' -ErrorAction SilentlyContinue | Stop-Process -Force -ErrorAction SilentlyContinue",
            "    Start-Sleep -Seconds 2",
            "}",
            "",
            "function Remove-RustDeskBinary {",
            "    param([Parameter(Mandatory = $true)][string]$Path)",
            "    if (-not (Test-Path -LiteralPath $Path -PathType Leaf)) {",
            "        return",
            "    }",
            "    $foundVersion = Get-RustDeskProductVersion -Path $Path",
            "    Write-Host \"Removing RustDesk $foundVersion at $Path\" -ForegroundColor Yellow",
            "    Stop-RustDeskProcesses",
            "    $process = Start-Process -FilePath $Path -ArgumentList '--uninstall' -PassThru -NoNewWindow",
            "    $deadline = (Get-Date).AddSeconds(60)",
            "    while ((Get-Date) -lt $deadline) {",
            "        Start-Sleep -Seconds 2",
            "        if (-not (Test-Path -LiteralPath $Path -PathType Leaf)) {",
            "            break",
            "        }",
            "    }",
            "    if (($null -ne $process) -and (-not $process.HasExited)) {",
            "        Stop-Process -Id $process.Id -Force -ErrorAction SilentlyContinue",
            "    }",
            "    Stop-RustDeskProcesses",
            "    if (Test-Path -LiteralPath $Path -PathType Leaf) {",
            "        Remove-Item -LiteralPath $Path -Force -ErrorAction SilentlyContinue",
            "    }",
            "    if (Test-Path -LiteralPath $Path -PathType Leaf) {",
            "        throw \"RustDesk executable is still present after uninstall: $Path (version $foundVersion)\"",
            "    }",
            "}",
            "",
            "Stop-RustDeskProcesses",
            "$existing = @(Get-RustDeskCandidatePaths)",
            "foreach ($candidate in $existing) {",
            "    $candidateVersion = Get-RustDeskProductVersion -Path $candidate",
            "    if ($candidateVersion -eq $expectedVersion -and $candidate -like \"$env:ProgramFiles\\RustDesk\\*\") {",
            "        continue",
            "    }",
            "    Remove-RustDeskBinary -Path $candidate",
            "}",
            "",
            "$service = Get-CimInstance Win32_Service -Filter \"Name='RustDesk'\" -ErrorAction SilentlyContinue",
            "if ($service) {",
            "    $serviceExe = Get-ExecutableFromCommandLine $service.PathName",
            "    $serviceVersion = Get-RustDeskProductVersion -Path $serviceExe",
            "    $serviceInProgramFiles = $serviceExe -and ($serviceExe -like \"$env:ProgramFiles\\RustDesk\\*\")",
            "    if ((-not $serviceInProgramFiles) -or ($serviceVersion -ne $expectedVersion)) {",
            "        Write-Host \"Removing RustDesk service that points at $serviceExe ($serviceVersion)\" -ForegroundColor Yellow",
            "        Stop-RustDeskProcesses",
            "        & sc.exe delete RustDesk | Out-Null",
            "        Start-Sleep -Seconds 2",
            "    }",
            "}",
            "",
            "$leftovers = @(Get-RustDeskCandidatePaths | Where-Object {",
            "    ($_ -notlike \"$env:ProgramFiles\\RustDesk\\*\") -or ((Get-RustDeskProductVersion -Path $_) -ne $expectedVersion)",
            "})",
            "if ($leftovers.Count -gt 0) {",
            "    throw (\"RustDesk leftovers are still installed: \" + ($leftovers -join '; '))",
            "}",
            "",
            "$rustDeskExe = Join-Path $env:ProgramFiles 'RustDesk\\rustdesk.exe'",
            "if (-not (Test-Path -LiteralPath $rustDeskExe)) {",
            "    $rustDeskExe = Join-Path $env:ProgramFiles 'RustDesk\\RustDesk.exe'",
            "}",
            "$needsInstall = $true",
            "if ((Test-Path -LiteralPath $rustDeskExe) -and ((Get-RustDeskProductVersion -Path $rustDeskExe) -eq $expectedVersion)) {",
            "    Write-Host \"RustDesk $expectedVersion is already installed in Program Files.\" -ForegroundColor Cyan",
            "    $needsInstall = $false",
            "}",
            "",
            "if ($needsInstall) {",
            "    Write-Host \"Installing RustDesk $expectedVersion to Program Files (silent, elevated)...\" -ForegroundColor Green",
            "    # --silent-install never exits (rustdesk/rustdesk#8956); do not use -Wait",
            "    $process = Start-Process -FilePath $installerPath -ArgumentList '--silent-install' -Verb RunAs -PassThru",
            "    if ($null -eq $process) {",
            "        throw 'RustDesk silent install was not started (admin approval may have been denied)'",
            "    }",
            "    $deadline = (Get-Date).AddSeconds(120)",
            "    $installed = $false",
            "    while ((Get-Date) -lt $deadline) {",
            "        Start-Sleep -Seconds 2",
            "        foreach ($name in @('rustdesk.exe', 'RustDesk.exe')) {",
            "            $candidate = Join-Path $env:ProgramFiles \"RustDesk\\$name\"",
            "            if ((Test-Path -LiteralPath $candidate) -and ((Get-RustDeskProductVersion -Path $candidate) -eq $expectedVersion)) {",
            "                $rustDeskExe = $candidate",
            "                $installed = $true",
            "                break",
            "            }",
            "        }",
            "        if ($installed) {",
            "            Start-Sleep -Seconds 3",
            "            break",
            "        }",
            "    }",
            "    if (-not $process.HasExited) {",
            "        Stop-Process -Id $process.Id -Force -ErrorAction SilentlyContinue",
            "    }",
            "    Get-CimInstance Win32_Process -ErrorAction SilentlyContinue |",
            "        Where-Object { $_.ExecutablePath -and ($_.ExecutablePath -ieq $installerPath) } |",
            "        ForEach-Object { Stop-Process -Id $_.ProcessId -Force -ErrorAction SilentlyContinue }",
            "    if (-not $installed) {",
            "        throw \"RustDesk silent install did not produce Program Files binary $expectedVersion\"",
            "    }",
            "}",
            "",
            "$installedVersion = Get-RustDeskProductVersion -Path $rustDeskExe",
            "if ($installedVersion -ne $expectedVersion) {",
            "    throw \"RustDesk in Program Files is $installedVersion, expected $expectedVersion ($rustDeskExe)\"",
            "}",
            "",
            "$launcherPath = \"$dir\\rustdesk.cmd\"",
            "$launcherLines = @('@echo off', ('\"' + $rustDeskExe + '\" %*'))",
            "Set-Content -Path $launcherPath -Value ($launcherLines -join [Environment]::NewLine) -Encoding ASCII"
        ]
    },
    "post_install": [
        "$expectedVersion = $version",
        "if ($expectedVersion -match '^(\\d+\\.\\d+\\.\\d+)') {",
        "    $expectedVersion = $Matches[1]",
        "}",
        "",
        "function Get-RustDeskProductVersion {",
        "    param([Parameter(Mandatory = $true)][string]$Path)",
        "    if (-not (Test-Path -LiteralPath $Path -PathType Leaf)) {",
        "        return ''",
        "    }",
        "    $info = [System.Diagnostics.FileVersionInfo]::GetVersionInfo($Path)",
        "    $raw = $info.ProductVersion",
        "    if (-not $raw) {",
        "        $raw = $info.FileVersion",
        "    }",
        "    if (-not $raw) {",
        "        return ''",
        "    }",
        "    if ($raw -match '(\\d+\\.\\d+\\.\\d+)') {",
        "        return $Matches[1]",
        "    }",
        "    return $raw.Trim()",
        "}",
        "",
        "function Get-ExecutableFromCommandLine {",
        "    param([string]$CommandLine)",
        "    if (-not $CommandLine) {",
        "        return ''",
        "    }",
        "    $trimmed = $CommandLine.Trim()",
        "    if ($trimmed.StartsWith('\"')) {",
        "        $end = $trimmed.IndexOf('\"', 1)",
        "        if ($end -gt 1) {",
        "            return $trimmed.Substring(1, $end - 1)",
        "        }",
        "    }",
        "    $exeIndex = $trimmed.ToLowerInvariant().IndexOf('.exe')",
        "    if ($exeIndex -ge 0) {",
        "        return $trimmed.Substring(0, $exeIndex + 4).Trim('\"')",
        "    }",
        "    return ''",
        "}",
        "",
        "$rustDeskExe = Join-Path $env:ProgramFiles 'RustDesk\\rustdesk.exe'",
        "if (-not (Test-Path -LiteralPath $rustDeskExe)) {",
        "    $rustDeskExe = Join-Path $env:ProgramFiles 'RustDesk\\RustDesk.exe'",
        "}",
        "if (-not (Test-Path -LiteralPath $rustDeskExe)) {",
        "    throw 'RustDesk executable not found after installation'",
        "}",
        "$installedVersion = Get-RustDeskProductVersion -Path $rustDeskExe",
        "if ($installedVersion -ne $expectedVersion) {",
        "    throw \"RustDesk in Program Files is $installedVersion, expected $expectedVersion ($rustDeskExe)\"",
        "}",
        "",
        "$serviceInfo = Get-CimInstance Win32_Service -Filter \"Name='RustDesk'\" -ErrorAction SilentlyContinue",
        "$serviceExe = ''",
        "if ($serviceInfo) {",
        "    $serviceExe = Get-ExecutableFromCommandLine $serviceInfo.PathName",
        "}",
        "$serviceIsCurrent = $false",
        "if ($serviceExe -and (Test-Path -LiteralPath $serviceExe)) {",
        "    $samePath = [string]::Equals(",
        "        [System.IO.Path]::GetFullPath($serviceExe),",
        "        [System.IO.Path]::GetFullPath($rustDeskExe),",
        "        [System.StringComparison]::OrdinalIgnoreCase",
        "    )",
        "    $serviceIsCurrent = $samePath -and ((Get-RustDeskProductVersion -Path $serviceExe) -eq $expectedVersion)",
        "}",
        "if (-not $serviceIsCurrent) {",
        "    Write-Host \"Reinstalling RustDesk service so it runs $rustDeskExe ($expectedVersion) instead of $serviceExe\" -ForegroundColor Blue",
        "    Stop-Service -Name 'RustDesk' -Force -ErrorAction SilentlyContinue",
        "    Get-Process -Name 'rustdesk', 'RustDesk' -ErrorAction SilentlyContinue | Stop-Process -Force -ErrorAction SilentlyContinue",
        "    if ($serviceInfo) {",
        "        & sc.exe delete RustDesk | Out-Null",
        "        Start-Sleep -Seconds 2",
        "    }",
        "    # Same hang risk as --silent-install; poll for the service instead of -Wait",
        "    $serviceProcess = Start-Process -FilePath $rustDeskExe -ArgumentList '--install-service' -Verb RunAs -PassThru",
        "    if ($null -eq $serviceProcess) {",
        "        throw 'RustDesk --install-service was not started (admin approval may have been denied)'",
        "    }",
        "    $serviceDeadline = (Get-Date).AddSeconds(60)",
        "    $serviceInfo = $null",
        "    while ((Get-Date) -lt $serviceDeadline) {",
        "        Start-Sleep -Seconds 2",
        "        $serviceInfo = Get-CimInstance Win32_Service -Filter \"Name='RustDesk'\" -ErrorAction SilentlyContinue",
        "        if ($serviceInfo) {",
        "            break",
        "        }",
        "    }",
        "    if (-not $serviceProcess.HasExited) {",
        "        Stop-Process -Id $serviceProcess.Id -Force -ErrorAction SilentlyContinue",
        "    }",
        "}",
        "",
        "if (-not $serviceInfo) {",
        "    throw 'RustDesk Windows service not found after installation'",
        "}",
        "$serviceExe = Get-ExecutableFromCommandLine $serviceInfo.PathName",
        "$serviceVersion = Get-RustDeskProductVersion -Path $serviceExe",
        "$samePath = $serviceExe -and [string]::Equals(",
        "    [System.IO.Path]::GetFullPath($serviceExe),",
        "    [System.IO.Path]::GetFullPath($rustDeskExe),",
        "    [System.StringComparison]::OrdinalIgnoreCase",
        ")",
        "if ((-not $samePath) -or ($serviceVersion -ne $expectedVersion)) {",
        "    throw \"RustDesk service runs '$serviceExe' version '$serviceVersion', expected '$rustDeskExe' version '$expectedVersion'\"",
        "}",
        "",
        "Set-Service -Name 'RustDesk' -StartupType Automatic -ErrorAction Stop",
        "$service = Get-Service -Name 'RustDesk' -ErrorAction Stop",
        "if ($service.Status -ne 'Running') {",
        "    Start-Service -Name 'RustDesk' -ErrorAction Stop",
        "    $service = Get-Service -Name 'RustDesk' -ErrorAction Stop",
        "}",
        "if ($service.Status -ne 'Running') {",
        "    throw \"RustDesk service is $($service.Status), expected Running\"",
        "}",
        "",
        "$leftoverDirs = @(",
        "    (Join-Path ${env:ProgramFiles(x86)} 'RustDesk'),",
        "    (Join-Path $env:ProgramData 'RustDesk'),",
        "    (Join-Path $env:LOCALAPPDATA 'RustDesk')",
        ")",
        "$leftovers = @()",
        "foreach ($directory in $leftoverDirs) {",
        "    if (-not $directory) {",
        "        continue",
        "    }",
        "    foreach ($name in @('rustdesk.exe', 'RustDesk.exe')) {",
        "        $candidate = Join-Path $directory $name",
        "        if (Test-Path -LiteralPath $candidate -PathType Leaf) {",
        "            $leftovers += \"$candidate ($(Get-RustDeskProductVersion -Path $candidate))\"",
        "        }",
        "    }",
        "}",
        "if ($leftovers.Count -gt 0) {",
        "    throw (\"Older RustDesk executables are still present: \" + ($leftovers -join '; '))",
        "}",
        "",
        "if (-not $env:RUSTDESK_SETUP_KEY) {",
        "    $env:RUSTDESK_SETUP_KEY = [Environment]::GetEnvironmentVariable('RUSTDESK_SETUP_KEY', 'User')",
        "}",
        "if (-not $env:RUSTDESK_SETUP_KEY) {",
        "    $env:RUSTDESK_SETUP_KEY = [Environment]::GetEnvironmentVariable('RUSTDESK_SETUP_KEY', 'Machine')",
        "}",
        "",
        "$configPath = Join-Path $env:APPDATA 'RustDesk\\config\\RustDesk2.toml'",
        "if ($env:RUSTDESK_SETUP_KEY) {",
        "    Write-Host 'Applying self-hosted server configuration from RUSTDESK_SETUP_KEY...' -ForegroundColor Blue",
        "    $configProcess = Start-Process -FilePath $rustDeskExe -ArgumentList '--config', $env:RUSTDESK_SETUP_KEY -Wait -PassThru -NoNewWindow",
        "    if ($configProcess.ExitCode -ne 0) {",
        "        throw \"RustDesk --config failed with exit code $($configProcess.ExitCode)\"",
        "    }",
        "} elseif ((Test-Path -LiteralPath $configPath) -and (Select-String -Path $configPath -Pattern 'custom-rendezvous-server' -Quiet)) {",
        "    Write-Host 'RUSTDESK_SETUP_KEY not set; keeping existing server configuration.' -ForegroundColor Yellow",
        "} else {",
        "    throw 'RUSTDESK_SETUP_KEY environment variable not set and no existing server configuration found'",
        "}",
        "",
        "$rustDeskId = & $rustDeskExe --get-id 2>&1 | Select-Object -Last 1",
        "Remove-Item \"$dir\\rustdesk-installer.exe\" -Force -ErrorAction SilentlyContinue",
        "Write-Host \"RustDesk $expectedVersion is running from $rustDeskExe. ID: $rustDeskId (permanent password preserved)\" -ForegroundColor Green"
    ],
    "bin": "rustdesk.cmd",
    "shortcuts": [
        [
            "rustdesk.cmd",
            "RustDesk"
        ]
    ],
    "pre_uninstall": [
        "Stop-Service -Name 'RustDesk' -Force -ErrorAction SilentlyContinue",
        "Get-Process -Name 'rustdesk', 'RustDesk' -ErrorAction SilentlyContinue | Stop-Process -Force -ErrorAction SilentlyContinue",
        "Start-Sleep -Seconds 2"
    ],
    "uninstaller": {
        "script": [
            "function Get-ExecutableFromCommandLine {",
            "    param([string]$CommandLine)",
            "    if (-not $CommandLine) {",
            "        return ''",
            "    }",
            "    $trimmed = $CommandLine.Trim()",
            "    if ($trimmed.StartsWith('\"')) {",
            "        $end = $trimmed.IndexOf('\"', 1)",
            "        if ($end -gt 1) {",
            "            return $trimmed.Substring(1, $end - 1)",
            "        }",
            "    }",
            "    $exeIndex = $trimmed.ToLowerInvariant().IndexOf('.exe')",
            "    if ($exeIndex -ge 0) {",
            "        return $trimmed.Substring(0, $exeIndex + 4).Trim('\"')",
            "    }",
            "    return ''",
            "}",
            "",
            "function Add-RustDeskPath {",
            "    param($List, [string]$Path)",
            "    if (-not $Path) {",
            "        return",
            "    }",
            "    $Path = $Path.Trim().Trim('\"')",
            "    if (-not (Test-Path -LiteralPath $Path -PathType Leaf)) {",
            "        return",
            "    }",
            "    $full = [System.IO.Path]::GetFullPath($Path)",
            "    foreach ($item in $List) {",
            "        if ([string]::Equals($item, $full, [System.StringComparison]::OrdinalIgnoreCase)) {",
            "            return",
            "        }",
            "    }",
            "    [void]$List.Add($full)",
            "}",
            "",
            "function Get-RustDeskCandidatePaths {",
            "    $paths = New-Object System.Collections.Generic.List[string]",
            "    $directories = @(",
            "        (Join-Path $env:ProgramFiles 'RustDesk'),",
            "        (Join-Path ${env:ProgramFiles(x86)} 'RustDesk'),",
            "        (Join-Path $env:ProgramData 'RustDesk'),",
            "        (Join-Path $env:LOCALAPPDATA 'RustDesk')",
            "    )",
            "    foreach ($directory in $directories) {",
            "        if (-not $directory) {",
            "            continue",
            "        }",
            "        foreach ($name in @('rustdesk.exe', 'RustDesk.exe')) {",
            "            Add-RustDeskPath -List $paths -Path (Join-Path $directory $name)",
            "        }",
            "    }",
            "    $service = Get-CimInstance Win32_Service -Filter \"Name='RustDesk'\" -ErrorAction SilentlyContinue",
            "    if ($service) {",
            "        Add-RustDeskPath -List $paths -Path (Get-ExecutableFromCommandLine $service.PathName)",
            "    }",
            "    Get-Process -Name 'rustdesk', 'RustDesk' -ErrorAction SilentlyContinue | ForEach-Object {",
            "        Add-RustDeskPath -List $paths -Path $_.Path",
            "    }",
            "    return @($paths)",
            "}",
            "",
            "function Stop-RustDeskProcesses {",
            "    Stop-Service -Name 'RustDesk' -Force -ErrorAction SilentlyContinue",
            "    Get-Process -Name 'rustdesk', 'RustDesk' -ErrorAction SilentlyContinue | Stop-Process -Force -ErrorAction SilentlyContinue",
            "    Start-Sleep -Seconds 2",
            "}",
            "",
            "Stop-RustDeskProcesses",
            "foreach ($candidate in @(Get-RustDeskCandidatePaths)) {",
            "    Write-Host \"Uninstalling RustDesk at $candidate\" -ForegroundColor Yellow",
            "    $process = Start-Process -FilePath $candidate -ArgumentList '--uninstall' -PassThru -NoNewWindow",
            "    $deadline = (Get-Date).AddSeconds(60)",
            "    while ((Get-Date) -lt $deadline) {",
            "        Start-Sleep -Seconds 2",
            "        if (-not (Test-Path -LiteralPath $candidate -PathType Leaf)) {",
            "            break",
            "        }",
            "    }",
            "    if (($null -ne $process) -and (-not $process.HasExited)) {",
            "        Stop-Process -Id $process.Id -Force -ErrorAction SilentlyContinue",
            "    }",
            "    Stop-RustDeskProcesses",
            "    if (Test-Path -LiteralPath $candidate -PathType Leaf) {",
            "        Remove-Item -LiteralPath $candidate -Force -ErrorAction SilentlyContinue",
            "    }",
            "}",
            "",
            "if (Get-Service -Name 'RustDesk' -ErrorAction SilentlyContinue) {",
            "    Stop-RustDeskProcesses",
            "    & sc.exe delete RustDesk | Out-Null",
            "    Start-Sleep -Seconds 2",
            "}",
            "",
            "$remaining = @(Get-RustDeskCandidatePaths)",
            "$serviceLeft = Get-Service -Name 'RustDesk' -ErrorAction SilentlyContinue",
            "if (($remaining.Count -gt 0) -or $serviceLeft) {",
            "    $detail = @()",
            "    if ($remaining.Count -gt 0) {",
            "        $detail += ($remaining -join '; ')",
            "    }",
            "    if ($serviceLeft) {",
            "        $detail += 'Windows service RustDesk is still registered'",
            "    }",
            "    throw (\"RustDesk uninstall failed: \" + ($detail -join '; '))",
            "}",
            "",
            "Write-Host 'RustDesk uninstall completed. User configuration in %APPDATA%\\RustDesk was preserved.' -ForegroundColor Green"
        ]
    },
